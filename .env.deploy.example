# =============================================================================
# Configuration des opérations de production (ops/).
# Copier vers `.env.deploy` — fichier GITIGNORÉ : il désigne le serveur.
# Aucun secret applicatif ici : SESSION_SECRET et mot de passe PostgreSQL
# vivent uniquement dans le `.env` du serveur (voir `npm run prod:env`).
# =============================================================================

# --- Serveur -----------------------------------------------------------------
PROD_HOST="1.2.3.4"
PROD_USER="deploy"
PROD_SETUP_USER="ubuntu"
PROD_PORT="22"
# Chemin de la clé privée SSH. Vide = configuration ssh par défaut.
PROD_SSH_KEY=""
# Répertoire du dépôt sur le serveur
PROD_DIR="/home/deploy/secondbrain"

# --- Site --------------------------------------------------------------------
PROD_DOMAIN="secondbrain.example.com"

# --- Dépôt -------------------------------------------------------------------
PROD_REPO="https://github.com/danielbartcg/secondbrain.git"
PROD_BRANCH="main"

# --- Sauvegardes -------------------------------------------------------------
PROD_BACKUP_DIR="/home/deploy/backups-secondbrain"
BACKUP_RETENTION_DAYS="14"
BACKUP_LOCAL_DIR="backups"

# --- Cohabitation avec d'autres applications sur le serveur ------------------
# Port local publié par docker compose ; Caddy route le domaine vers ce port.
APP_PORT="3001"
# Nom court : fichiers système (site Caddy, cron).
SHOP_SLUG="secondbrain"
