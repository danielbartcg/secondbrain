{
  "name": "secondbrain",
  "version": "0.1.0",
  "private": true,
  "description": "Second Brain — cartes mentales avec notes riches et gestion de projets (étapes > activités > tâches), API REST /api/v1 prête pour une application mobile.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "user:create": "tsx scripts/create-user.ts",
    "prod:setup": "tsx ops/setup.ts",
    "prod:deploy": "tsx ops/deploy.ts",
    "prod:status": "tsx ops/status.ts",
    "prod:logs": "tsx ops/logs.ts",
    "prod:exec": "tsx ops/exec.ts",
    "prod:env": "tsx ops/env.ts",
    "prod:backup": "tsx ops/backup.ts",
    "test:sync": "tsx scripts/sync-e2e.ts",
    "test:native": "tsx native/tests/offline-e2e.ts",
    "native:dev": "vite --config native/vite.config.mts",
    "native:build": "vite build --config native/vite.config.mts",
    "desktop:dev": "node native/scripts/desktop-dev.mjs",
    "desktop:build": "npm run native:build && electron-builder --config native/electron-builder.yml --win",
    "desktop:smoke": "npm run native:build && electron native/electron --smoke-test",
    "desktop:publish": "tsx ops/desktop-publish.ts",
    "ios:sync": "npm run native:build && cap sync ios",
    "ios:open": "cap open ios",
    "test:features": "tsx scripts/features-e2e.ts",
    "test:risks": "tsx scripts/risks-test.ts",
    "test:pptx": "tsx scripts/pptx-export-test.ts",
    "test:admin-users": "tsx scripts/admin-users-test.ts",
    "test:gantt": "tsx scripts/gantt-model-test.ts",
    "test:activity": "tsx scripts/activity-test.ts",
    "test:custom-fields": "tsx scripts/custom-fields-test.ts",
    "test:templates": "tsx scripts/templates-test.ts",
    "test:map-shares": "tsx scripts/map-shares-test.ts",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "perf:bench": "tsx scripts/perf-bench.ts"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.40",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@emoji-mart/data": "1.2.1",
    "@prisma/client": "6.19.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-cell": "2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-table-row": "2.27.3",
    "@tiptap/extension-task-item": "2.27.3",
    "@tiptap/extension-task-list": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@xyflow/react": "12.12.0",
    "bcryptjs": "3.0.3",
    "d3-hierarchy": "3.1.2",
    "emoji-mart": "5.6.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.55.0",
    "next": "15.5.27",
    "nodemailer": "10.0.13",
    "pptxgenjs": "4.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "2.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/sanitize-html": "2.16.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.5",
    "postcss": "8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
