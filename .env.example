# Base PostgreSQL (docker compose : voir docker-compose.yml)
DATABASE_URL="postgresql://secondbrain:secondbrain@localhost:5433/secondbrain?schema=public"
POSTGRES_PASSWORD="secondbrain"
# Secret des sessions (openssl rand -hex 32)
SESSION_SECRET="change-me"
# URL publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Inscription ouverte ? (false : seuls les comptes créés par `npm run user:create` peuvent se connecter)
ALLOW_REGISTRATION="true"
# Port local publié par docker compose
APP_PORT="3001"
