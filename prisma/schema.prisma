// Second Brain — modèle de données.
// Documentation : docs/02-data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Comptes et sessions
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  /// Nom affiché (« Prénom Nom »), recalculé depuis firstName / lastName.
  name               String
  firstName          String    @default("")
  lastName           String    @default("")
  /// Photo de profil (URL /media/…) ; null = silhouette.
  avatarUrl          String?
  /// Thème d'affichage : light · dark · sepia · ocean · forest.
  theme              String    @default("light")
  /// ADMIN : accès à l'administration (le super administrateur est codé en dur).
  role               UserRole  @default(USER)
  /// Manager (N+1) : voit en lecture les tâches de ses N-1.
  managerId          String?
  manager            User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports            User[]    @relation("UserManager")
  /// Adresse validée (lien reçu par e-mail) ; informatif, n'empêche pas la connexion.
  emailVerifiedAt    DateTime?
  /// Copies e-mail des notifications (préférence personnelle).
  emailNotifications Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions             Session[]
  emailTokens          EmailToken[]
  apiKeys              ApiKey[]
  pins                 Pin[]
  taskEvents           TaskEvent[]               @relation("TaskEventActor")
  meetingsAuthored     Meeting[]                 @relation("MeetingAuthor")
  mindMaps             MindMap[]
  projects             Project[]
  memberships          ProjectMember[]
  comments             TaskComment[]
  documents            Document[]
  workSessions         WorkSession[]
  taskRanks            TaskRank[]
  notifications        Notification[]
  ownedTasks           Task[]
  conversations        ConversationParticipant[]
  messages             Message[]                 @relation("MessageAuthor")
  conversationsCreated Conversation[]            @relation("ConversationCreator")

  @@index([managerId])
}

/// Session opaque : le même jeton sert de cookie `session` (web) et de
/// `Authorization: Bearer` (application mobile).
model Session {
  id        String   @id @default(cuid())
  /// Empreinte SHA-256 (hex) du jeton opaque ; le jeton en clair n'est jamais stocké
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Libellé libre du client (« Web », « iPhone de Daniel »…)
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cartes mentales
// ---------------------------------------------------------------------------

model MindMap {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes MindNode[]

  @@index([ownerId])
}

/// Statut d'un nœud : à surveiller = mis en évidence ; fermé = hachuré et
/// masqué par défaut (avec sa descendance).
enum NodeStatus {
  OPEN
  WATCH
  CLOSED
}

/// Nœud d'une carte : arbre par `parentId` (null = racine), ordonné par `order`.
model MindNode {
  id        String     @id @default(cuid())
  mapId     String
  map       MindMap    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MindNode?  @relation("MindNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MindNode[] @relation("MindNodeTree")
  title     String
  /// Notes au format HTML (assainies à l'enregistrement ET au rendu).
  notes     String     @default("")
  color     String?
  collapsed Boolean    @default(false)
  status    NodeStatus @default(OPEN)
  order     Int        @default(0)
  /// Position manuelle sur le canevas (null = calculée automatiquement).
  x         Float?
  y         Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Tâches rattachées à ce nœud (avec ou sans projet).
  tasks MindNodeTask[]

  @@index([mapId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Gestion de projet : Projet > Étape > (Activité) > Tâche
//                     + équipe, livrables, documents, commentaires
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  /// Clôture manuelle, après DONE : la tâche sort du flux courant.
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Complexité estimée (axe horizontal de la vue « Sélection »).
enum TaskComplexity {
  LOW
  MEDIUM
  HIGH
}

enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  DELIVERED
  VALIDATED
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String        @default("")
  /// Notes riches (HTML assaini) prises depuis « Prise de notes ».
  notes       String        @default("")
  color       String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stages       Stage[]
  members      ProjectMember[]
  deliverables Deliverable[]
  documents    Document[]
  folders      Folder[]
  risks        Risk[]
  meetings     Meeting[]
  tasks        Task[]

  @@index([ownerId])
}

/// Membre de l'équipe projet : soit un compte de l'application (`userId`),
/// soit un simple nom saisi en dur. Les tâches et livrables lui sont affectés.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  /// Rôle dans le projet (libre : « Chef de projet », « Développeur »…)
  role      String?
  color     String?
  createdAt DateTime @default(now())

  tasks           Task[]               @relation("TaskAssignee")
  supervisedTasks Task[]               @relation("TaskSupervisor")
  contributions   TaskContributor[]
  deliverables    Deliverable[]
  ownedRisks      Risk[]
  meetingSeats    MeetingParticipant[]
  meetingReviews  MeetingApprover[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Stage {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  notes       String    @default("")
  order       Int       @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activities   Activity[]
  tasks        Task[]
  deliverables Deliverable[]

  @@index([projectId])
}

/// Niveau intermédiaire facultatif : une tâche peut être rattachée
/// directement à l'étape (activityId null).
model Activity {
  id          String   @id @default(cuid())
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  notes       String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  @@index([stageId])
}

/// Tâche. Rattachements facultatifs et cohérents : activité ⇒ étape ⇒ projet.
/// Sans projet = tâche « orpheline », visible par son créateur (`ownerId`).
model Task {
  id              String         @id @default(cuid())
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId         String?
  stage           Stage?         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  activityId      String?
  activity        Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        ProjectMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Superviseur de la tâche (un seul membre).
  supervisorId    String?
  supervisor      ProjectMember? @relation("TaskSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  name            String
  description     String         @default("")
  notes           String         @default("")
  status          TaskStatus     @default(TODO)
  /// Avancement 0..100 ; DONE force 100.
  progress        Int            @default(0)
  priority        TaskPriority   @default(MEDIUM)
  complexity      TaskComplexity @default(MEDIUM)
  order           Int            @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  /// Date de clôture : posée automatiquement au passage à CLOSED, effacée à la
  /// réouverture, modifiable tant que la tâche est clôturée.
  closedAt        DateTime?
  /// Tâches prérequises (même projet, sans cycle) : diagramme de Gantt et alertes de planning.
  /// Liste d'identifiants (champ synchronisé comme les autres colonnes).
  prerequisiteIds String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  comments      TaskComment[]
  workSessions  WorkSession[]
  ranks         TaskRank[]
  notifications Notification[]
  nodes         MindNodeTask[]
  /// Contributeurs (plusieurs membres).
  contributors  TaskContributor[]
  /// Piste d'audit (historique des modifications).
  events        TaskEvent[]
  /// Risques / opportunités liés.
  risks         RiskTask[]

  @@index([ownerId])
  @@index([supervisorId])
  @@index([projectId])
  @@index([stageId])
  @@index([activityId])
  @@index([assigneeId])
}

/// Contributeur d'une tâche (membre du même projet).
model TaskContributor {
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId  String
  member    ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([taskId, memberId])
  @@index([memberId])
}

/// Rattachement d'une tâche à un nœud de carte mentale (plusieurs nœuds
/// possibles pour une tâche, plusieurs tâches par nœud).
model MindNodeTask {
  nodeId    String
  node      MindNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([nodeId, taskId])
  @@index([taskId])
}

/// Commentaire sur une tâche. `body` contient des mentions au format
/// `@[Nom](memberId)` ; `mentions` liste les identifiants de membres cités.
model TaskComment {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Réponse à un autre commentaire (fil de profondeur illimitée) ; null = racine.
  parentId  String?
  parent    TaskComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[] @relation("CommentThread")
  body      String
  mentions  String[]      @default([])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([taskId])
  @@index([parentId])
}

/// Session de travail planifiée : un jour où l'utilisateur prévoit de
/// travailler sur la tâche (vue calendaire). Plusieurs jours par tâche.
model WorkSession {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([taskId, userId, date])
  @@index([userId, date])
}

/// Ordre relatif personnel des tâches (vue « Synthèse ») : propre à chaque
/// utilisateur, indépendant de l'ordre dans le plan du projet.
model TaskRank {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rank   Int

  @@id([userId, taskId])
  @@index([userId, rank])
}

enum NotificationType {
  MENTION
  REPLY
  TASK_UPDATED
  ASSIGNED
  /// Nouveau message dans une conversation (regroupé : une notification non lue par conversation).
  MESSAGE
  /// Un compte-rendu de réunion attend votre validation (regroupée par réunion).
  MEETING_REVIEW
  /// Un validateur a validé ou refusé votre compte-rendu.
  MEETING_DECISION
}

/// Envoi de la copie e-mail d'une notification (null : pas d'e-mail à envoyer).
enum EmailState {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Lien à usage unique envoyé par e-mail (validation d'adresse, mot de passe oublié).
enum EmailTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  /// Empreinte SHA-256 (hex) du jeton ; le jeton en clair n'existe que dans l'e-mail.
  tokenHash String         @unique
  /// Adresse concernée (validation : l'adresse à confirmer).
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, kind])
}

/// Clé d'accès personnelle (connecteur MCP pour Claude Desktop…) ; agit au nom de l'utilisateur.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Début de la clé, affiché pour la reconnaître (« sb_AbCd… »).
  prefix     String
  /// Empreinte SHA-256 (hex) de la clé ; la clé en clair n'est montrée qu'une fois.
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Piste d'audit d'une tâche : une ligne par modification, message lisible
/// figé à l'écriture (« Alice a modifié la date de début de 01/10 à 05/10 »).
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  /// created · field · assignee · supervisor · contributors · prerequisites · attachment · comment · session · node · risk
  kind      String
  field     String?
  oldValue  String?
  newValue  String?
  message   String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Gestion des risques du projet : risques (menaces) et opportunités, cotés
/// en probabilité × gravité (1 à 5), avec tâches liées.
enum RiskKind {
  RISK
  OPPORTUNITY
}

enum RiskStatus {
  OPEN
  MONITORING
  TREATED
  CLOSED
}

model Risk {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        RiskKind       @default(RISK)
  title       String
  description String         @default("")
  category    String         @default("")
  /// 1 (rare) à 5 (quasi certain)
  probability Int            @default(3)
  /// Gravité (risque) ou bénéfice (opportunité) : 1 (faible) à 5 (majeur)
  impact      Int            @default(3)
  status      RiskStatus     @default(OPEN)
  /// Responsable : membre du projet.
  ownerId     String?
  owner       ProjectMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Plan de traitement (risque) ou d'exploitation (opportunité).
  response    String         @default("")
  dueDate     DateTime?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tasks       RiskTask[]

  @@index([projectId])
}

model RiskTask {
  riskId String
  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([riskId, taskId])
  @@index([taskId])
}

/// Réunion de projet et son compte-rendu (HTML assaini) soumis à validation.
enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model Meeting {
  id               String               @id @default(cuid())
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  date             DateTime
  location         String               @default("")
  /// Rédacteur du compte-rendu (créateur par défaut).
  authorId         String?
  author           User?                @relation("MeetingAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  minutes          String               @default("")
  minutesUpdatedAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  participants     MeetingParticipant[]
  approvers        MeetingApprover[]

  @@index([projectId, date])
}

model MeetingParticipant {
  meetingId String
  meeting   Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([meetingId, memberId])
}

/// Validateur du compte-rendu (membre avec compte) ; toute modification du
/// compte-rendu remet les décisions à PENDING.
model MeetingApprover {
  meetingId String
  meeting   Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    ProjectMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  decision  ApprovalDecision @default(PENDING)
  comment   String           @default("")
  decidedAt DateTime?

  @@id([meetingId, memberId])
}

/// Élément épinglé dans le menu de gauche (projet ou carte mentale), par utilisateur.
enum PinKind {
  PROJECT
  MINDMAP
}

model Pin {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      PinKind
  targetId  String
  createdAt DateTime @default(now())

  @@id([userId, kind, targetId])
}

// ---------------------------------------------------------------------------
// Synchronisation hors ligne (applications desktop / iPhone) — docs/05-offline-sync.md
// ---------------------------------------------------------------------------

enum SyncOp {
  UPSERT
  DELETE
}

/// Journal des écritures, alimenté par un déclencheur PostgreSQL sur chaque
/// table synchronisée : une ligne par création, par champ modifié ou par
/// suppression. `seq` sert de curseur de synchro et de version par champ.
model SyncLog {
  seq       BigInt   @id @default(autoincrement())
  entity    String
  entityId  String
  /// Champ modifié ; null = création ou suppression (tous les champs).
  field     String?
  op        SyncOp
  /// Portée de diffusion : projet, carte, ou propriétaire (tâches sans projet, cartes).
  projectId String?
  mapId     String?
  ownerId   String?
  at        DateTime @default(now())

  @@index([projectId, seq])
  @@index([mapId, seq])
  @@index([ownerId, seq])
  @@index([entityId])
}

/// Opérations déjà rejouées (idempotence des renvois après coupure réseau).
model AppliedOp {
  opId      String
  userId    String
  result    Json
  createdAt DateTime @default(now())

  @@id([userId, opId])
}

/// Notification in-app : destinataire, type, texte, lien ; `readAt` null = non lue.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String           @default("")
  href       String
  taskId     String?
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId  String?
  actorName  String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  /// Copie e-mail (docs/02-data-model.md, « Notifications par e-mail »).
  emailState EmailState?
  emailError String?

  @@index([userId, readAt, createdAt])
  @@index([emailState, createdAt])
}

/// Paramètres globaux de la plateforme (une seule ligne, id = "global"),
/// gérés dans Administration → Notifications.
model AppSettings {
  id                  String             @id @default("global")
  smtpHost            String             @default("")
  smtpPort            Int                @default(587)
  /// true : TLS dès la connexion (port 465) ; false : STARTTLS si proposé.
  smtpSecure          Boolean            @default(false)
  smtpUser            String             @default("")
  /// Mot de passe SMTP chiffré (AES-256-GCM, clé dérivée de SESSION_SECRET) ; jamais renvoyé au client.
  smtpPasswordEnc     String             @default("")
  smtpFrom            String             @default("")
  /// Doubler les notifications d'un e-mail.
  emailEnabled        Boolean            @default(false)
  /// Types de notification désactivés pour tout le monde (ni cloche, ni e-mail).
  disabledTypes       NotificationType[] @default([])
  /// Types sans copie e-mail.
  emailDisabledTypes  NotificationType[] @default([])
  /// Inscriptions libres depuis la page de connexion (ALLOW_REGISTRATION=false les ferme quoi qu'il arrive).
  registrationEnabled Boolean            @default(true)
  updatedAt           DateTime           @updatedAt
}

/// Messagerie interne : fil de discussion entre deux utilisateurs ou plus.
model Conversation {
  id            String                    @id @default(cuid())
  /// Titre facultatif (fils de groupe) ; vide = noms des participants.
  title         String                    @default("")
  createdById   String?
  createdBy     User?                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                  @default(now())
  lastMessageAt DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]
}

/// Participant d'une conversation ; `lastReadAt` porte le « vu / non vu ».
model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

/// Message (HTML assaini). Suppression = effacement du contenu (`deletedAt`),
/// la place reste dans le fil ; `replyToId` : réponse à un message précis.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  replyToId      String?
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReply")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, updatedAt])
}

/// Livrable attendu du projet, éventuellement rattaché à une étape.
model Deliverable {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId       String?
  stage         Stage?            @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      ProjectMember?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  name          String
  description   String            @default("")
  status        DeliverableStatus @default(PLANNED)
  expectedStart DateTime?
  expectedEnd   DateTime?
  deliveredAt   DateTime?
  order         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  documents Document[]

  @@index([projectId])
  @@index([stageId])
}

/// Dossier de l'arborescence documentaire d'un projet (racine = parentId null).
model Folder {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([projectId])
  @@index([parentId])
}

/// Document du projet (fichier stocké sous DATA_DIR/documents), rangé dans un
/// dossier (ou à la racine) et pouvant matérialiser un livrable.
model Document {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Nom affiché (modifiable)
  name          String
  /// Nom d'origine du fichier téléversé
  originalName  String
  mimeType      String
  size          Int
  /// Chemin relatif à DATA_DIR/documents (nom aléatoire)
  storagePath   String
  createdAt     DateTime     @default(now())

  @@index([projectId])
  @@index([folderId])
  @@index([deliverableId])
}
