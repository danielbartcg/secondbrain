// Second Brain — modèle de données.
// Documentation : docs/02-data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Comptes et sessions
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Nom affiché (« Prénom Nom »), recalculé depuis firstName / lastName.
  name         String
  firstName    String   @default("")
  lastName     String   @default("")
  /// Photo de profil (URL /media/…) ; null = silhouette.
  avatarUrl    String?
  /// Thème d'affichage : light · dark · sepia · ocean · forest.
  theme        String   @default("light")
  /// ADMIN : accès à l'administration (le super administrateur est codé en dur).
  role         UserRole @default(USER)
  /// Manager (N+1) : voit en lecture les tâches de ses N-1.
  managerId    String?
  manager      User?    @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]   @relation("UserManager")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  mindMaps      MindMap[]
  projects      Project[]
  memberships   ProjectMember[]
  comments      TaskComment[]
  documents     Document[]
  workSessions  WorkSession[]
  taskRanks     TaskRank[]
  notifications Notification[]
  ownedTasks    Task[]

  @@index([managerId])
}

/// Session opaque : le même jeton sert de cookie `session` (web) et de
/// `Authorization: Bearer` (application mobile).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Libellé libre du client (« Web », « iPhone de Daniel »…)
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cartes mentales
// ---------------------------------------------------------------------------

model MindMap {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes MindNode[]

  @@index([ownerId])
}

/// Statut d'un nœud : à surveiller = mis en évidence ; fermé = hachuré et
/// masqué par défaut (avec sa descendance).
enum NodeStatus {
  OPEN
  WATCH
  CLOSED
}

/// Nœud d'une carte : arbre par `parentId` (null = racine), ordonné par `order`.
model MindNode {
  id        String     @id @default(cuid())
  mapId     String
  map       MindMap    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MindNode?  @relation("MindNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MindNode[] @relation("MindNodeTree")
  title     String
  /// Notes au format HTML (assainies à l'enregistrement ET au rendu).
  notes     String     @default("")
  color     String?
  collapsed Boolean    @default(false)
  status    NodeStatus @default(OPEN)
  order     Int        @default(0)
  /// Position manuelle sur le canevas (null = calculée automatiquement).
  x         Float?
  y         Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Tâches rattachées à ce nœud (avec ou sans projet).
  tasks MindNodeTask[]

  @@index([mapId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Gestion de projet : Projet > Étape > (Activité) > Tâche
//                     + équipe, livrables, documents, commentaires
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  /// Clôture manuelle, après DONE : la tâche sort du flux courant.
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Complexité estimée (axe horizontal de la vue « Sélection »).
enum TaskComplexity {
  LOW
  MEDIUM
  HIGH
}

enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  DELIVERED
  VALIDATED
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String        @default("")
  /// Notes riches (HTML assaini) prises depuis « Prise de notes ».
  notes       String        @default("")
  color       String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stages       Stage[]
  members      ProjectMember[]
  deliverables Deliverable[]
  documents    Document[]
  folders      Folder[]
  tasks        Task[]

  @@index([ownerId])
}

/// Membre de l'équipe projet : soit un compte de l'application (`userId`),
/// soit un simple nom saisi en dur. Les tâches et livrables lui sont affectés.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  /// Rôle dans le projet (libre : « Chef de projet », « Développeur »…)
  role      String?
  color     String?
  createdAt DateTime @default(now())

  tasks           Task[]            @relation("TaskAssignee")
  supervisedTasks Task[]            @relation("TaskSupervisor")
  contributions   TaskContributor[]
  deliverables    Deliverable[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Stage {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  notes       String    @default("")
  order       Int       @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  activities   Activity[]
  tasks        Task[]
  deliverables Deliverable[]

  @@index([projectId])
}

/// Niveau intermédiaire facultatif : une tâche peut être rattachée
/// directement à l'étape (activityId null).
model Activity {
  id          String   @id @default(cuid())
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  notes       String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  @@index([stageId])
}

/// Tâche. Rattachements facultatifs et cohérents : activité ⇒ étape ⇒ projet.
/// Sans projet = tâche « orpheline », visible par son créateur (`ownerId`).
model Task {
  id           String         @id @default(cuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId      String?
  stage        Stage?         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  activityId   String?
  activity     Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignee     ProjectMember? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Superviseur de la tâche (un seul membre).
  supervisorId String?
  supervisor   ProjectMember? @relation("TaskSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  name         String
  description  String         @default("")
  notes        String         @default("")
  status       TaskStatus     @default(TODO)
  /// Avancement 0..100 ; DONE force 100.
  progress     Int            @default(0)
  priority     TaskPriority   @default(MEDIUM)
  complexity   TaskComplexity @default(MEDIUM)
  order        Int            @default(0)
  startDate    DateTime?
  dueDate      DateTime?
  /// Date de clôture : posée automatiquement au passage à CLOSED, effacée à la
  /// réouverture, modifiable tant que la tâche est clôturée.
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments      TaskComment[]
  workSessions  WorkSession[]
  ranks         TaskRank[]
  notifications Notification[]
  nodes         MindNodeTask[]
  /// Contributeurs (plusieurs membres).
  contributors  TaskContributor[]

  @@index([ownerId])
  @@index([supervisorId])
  @@index([projectId])
  @@index([stageId])
  @@index([activityId])
  @@index([assigneeId])
}

/// Contributeur d'une tâche (membre du même projet).
model TaskContributor {
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId  String
  member    ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([taskId, memberId])
  @@index([memberId])
}

/// Rattachement d'une tâche à un nœud de carte mentale (plusieurs nœuds
/// possibles pour une tâche, plusieurs tâches par nœud).
model MindNodeTask {
  nodeId    String
  node      MindNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([nodeId, taskId])
  @@index([taskId])
}

/// Commentaire sur une tâche. `body` contient des mentions au format
/// `@[Nom](memberId)` ; `mentions` liste les identifiants de membres cités.
model TaskComment {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Réponse à un autre commentaire (fil de profondeur illimitée) ; null = racine.
  parentId  String?
  parent    TaskComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[] @relation("CommentThread")
  body      String
  mentions  String[]      @default([])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([taskId])
  @@index([parentId])
}

/// Session de travail planifiée : un jour où l'utilisateur prévoit de
/// travailler sur la tâche (vue calendaire). Plusieurs jours par tâche.
model WorkSession {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([taskId, userId, date])
  @@index([userId, date])
}

/// Ordre relatif personnel des tâches (vue « Synthèse ») : propre à chaque
/// utilisateur, indépendant de l'ordre dans le plan du projet.
model TaskRank {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rank   Int

  @@id([userId, taskId])
  @@index([userId, rank])
}

enum NotificationType {
  MENTION
  REPLY
  TASK_UPDATED
  ASSIGNED
}

// ---------------------------------------------------------------------------
// Synchronisation hors ligne (applications desktop / iPhone) — docs/05-offline-sync.md
// ---------------------------------------------------------------------------

enum SyncOp {
  UPSERT
  DELETE
}

/// Journal des écritures, alimenté par un déclencheur PostgreSQL sur chaque
/// table synchronisée : une ligne par création, par champ modifié ou par
/// suppression. `seq` sert de curseur de synchro et de version par champ.
model SyncLog {
  seq       BigInt   @id @default(autoincrement())
  entity    String
  entityId  String
  /// Champ modifié ; null = création ou suppression (tous les champs).
  field     String?
  op        SyncOp
  /// Portée de diffusion : projet, carte, ou propriétaire (tâches sans projet, cartes).
  projectId String?
  mapId     String?
  ownerId   String?
  at        DateTime @default(now())

  @@index([projectId, seq])
  @@index([mapId, seq])
  @@index([ownerId, seq])
  @@index([entityId])
}

/// Opérations déjà rejouées (idempotence des renvois après coupure réseau).
model AppliedOp {
  opId      String
  userId    String
  result    Json
  createdAt DateTime @default(now())

  @@id([userId, opId])
}

/// Notification in-app : destinataire, type, texte, lien ; `readAt` null = non lue.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @default("")
  href      String
  taskId    String?
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

/// Livrable attendu du projet, éventuellement rattaché à une étape.
model Deliverable {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId       String?
  stage         Stage?            @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      ProjectMember?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  name          String
  description   String            @default("")
  status        DeliverableStatus @default(PLANNED)
  expectedStart DateTime?
  expectedEnd   DateTime?
  deliveredAt   DateTime?
  order         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  documents Document[]

  @@index([projectId])
  @@index([stageId])
}

/// Dossier de l'arborescence documentaire d'un projet (racine = parentId null).
model Folder {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([projectId])
  @@index([parentId])
}

/// Document du projet (fichier stocké sous DATA_DIR/documents), rangé dans un
/// dossier (ou à la racine) et pouvant matérialiser un livrable.
model Document {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Nom affiché (modifiable)
  name          String
  /// Nom d'origine du fichier téléversé
  originalName  String
  mimeType      String
  size          Int
  /// Chemin relatif à DATA_DIR/documents (nom aléatoire)
  storagePath   String
  createdAt     DateTime     @default(now())

  @@index([projectId])
  @@index([folderId])
  @@index([deliverableId])
}
